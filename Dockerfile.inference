FROM golang:1.24 AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/inference ./cmd/inference

FROM gcr.io/distroless/base-debian12:nonroot
COPY --from=build /out/inference /app/inference

EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app/inference"]
